# Toolchain installed by docs/operator-quickstart.md §2.
#
# The quickstart tells you to copy a scratch node_modules into kotoba/.
# Without this file a later `git add -A` stages those trees, which inflates the
# tracked file count and makes docs/verify-custody.cljk report a false
# divergence.
node_modules/
__pycache__/
*.pyc
.svelte-kit/
build/
.vite/
test-results/

# shadow-cljs のビルド出力と作業ディレクトリ。
# appview/maps-tile-server-t1l3srv0/wrangler.jsonc の main が指す先だが、
# 生成物なので commit しない（scripts/smoke-worker.cljk は「ビルドしてから」
# 実行する gate で、bundle が無ければ exit 2 = 判定できなかった、を返す）。
dist/
.shadow-cljs/
.cpcache/
.wrangler/

# nbb dependency cache -- a build artifact, not source
.nbb/
