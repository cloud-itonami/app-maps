;; kotoba-datomic-projection manifest for maps-ui-uqpel6i6
;;
;; Per ADR-2605231500, this directory's Kysely / RW reads are a derived
;; read-path cache, not canonical state. Canonical state lives on:
;;   - com.etzhayyim.maps.* records in the maps.etzhayyim.com PDS (MST)
;;   - content blobs in IPFS (gsplat PLY/GLB, KAMI bake outputs)
;;   - Base L2 anchor (MST root commitments, post-Phase 6)
;;
;; This manifest exempts the storage-substrate lint rule for files under
;; this directory. The exemption is conditional on the rebuild runbook below
;; remaining executable.

{:projection/name "maps-spatial-rw"
 :projection/level :l0-projection
 :projection/rebuild-runbook "../../tools/rebuild-spatial-projection.md"
 :projection/adr "2605231500"
 :projection/kotoba-companion-adr "2605231400"
 :projection/related-migration "60-apps/etzhayyim-project-maps/MIGRATION-TODO.md"
 :projection/owner "maps-ui maintainers"
 :projection/last-reviewed "2026-05-23"

