  "mv_maps_recent_trip_update"
  "mv_maps_active_alerts"
  "mv_maps_gsplat_job_latest"]

 :projection/storage-substrates
 [{:kind :risingwave
   :binding "HYPERDRIVE"
   :note "primary projection - append-only INSERT via Kysely"}
  {:kind :r2
   :binding "YATA_R2"
   :note "edge cache for tile / blob fallback"}
  {:kind :b2
   :note "gsplat PLY/GLB content-addressed - migrates to IPFS in MIGRATION-TODO Phase 2"}]

 :projection/rebuild-estimated-minutes 240
 :projection/rebuild-estimated-minutes-note
 "dominated by vertex_spatial (~10M rows) + GTFS feeds (~5M stop_times) + 6 month gsplat job log replay"

 :projection/non-determinism
 [{:field "vertex_spatial.row_id"
   :reason "sequence-allocated on INSERT; replays produce same logical row, different physical ID"}
  {:field "vertex_maps_*.created_at_db"
   :reason "RW server timestamp at INSERT time, not in source record"}
  {:field "mv_maps_recent_*.materialized_at"
   :reason "streaming MV refresh timestamp; not a function of source"}]}
