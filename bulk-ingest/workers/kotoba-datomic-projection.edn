;; kotoba-datomic-projection manifest for etzhayyim-project-maps/bulk-ingest/workers
;;
;; Per ADR-2605231500, these worker scripts seed and refresh the derived
;; read-path RW projection for the maps app. They are NOT canonical state.
;; Canonical state lives on:
;;   - com.etzhayyim.maps.* records in the maps.etzhayyim.com PDS (MST)
;;   - external upstream datasets (OSM / OpenFlights / Wikidata / NOAA AIS /
;;     GTFS / Geonames / Wikipedia / Overture / Sentinel) re-fetchable from
;;     their public mirrors documented in the rebuild runbook
;;   - Base L2 anchor (MST root commitments, post-Phase 6)
;;
;; This manifest exempts the storage-substrate lint rule for direct
;; psycopg2 imports in this directory. The exemption is conditional on
;; the rebuild runbook below remaining executable.

{:projection/name "maps-bulk-ingest-rw"
 :projection/level :l0-projection
 :projection/rebuild-runbook "../MIGRATION-TODO.md"
 :projection/adr "2605231500"
 :projection/kotoba-companion-adr "2605231400"
 :projection/related-migration "60-apps/etzhayyim-project-maps/MIGRATION-TODO.md"
 :projection/owner "maps bulk-ingest maintainers"
 :projection/last-reviewed "2026-05-23"

 :projection/source-collections
 ["com.etzhayyim.maps.feature"
  "com.etzhayyim.maps.adminArea"
  "com.etzhayyim.maps.region"
  "com.etzhayyim.maps.geoAlias"
  "com.etzhayyim.maps.source"
  "com.etzhayyim.maps.road"
  "com.etzhayyim.maps.railway"
  "com.etzhayyim.maps.seaRoute"
  "com.etzhayyim.maps.airRoute"
  "com.etzhayyim.maps.airport"
  "com.etzhayyim.maps.station"
  "com.etzhayyim.maps.port"
  "com.etzhayyim.maps.vehiclePosition"
  "com.etzhayyim.maps.tripUpdate"
  "com.etzhayyim.maps.serviceAlert"
  "com.etzhayyim.maps.gsplatAsset"
  "com.etzhayyim.maps.gsplatJob"
  "com.etzhayyim.maps.visionResult"
  "com.etzhayyim.maps.satelliteScene"]

 :projection/tables
 ["vertex_spatial"
  "vertex_maps_vehicle_position"
  "vertex_maps_trip_update"
  "vertex_maps_service_alert"
  "vertex_legal_entity"
  "vertex_osm_element"
  "vertex_vessel"
  "vertex_maps_gsplat_asset"
  "vertex_maps_gsplat_job"]

 :projection/storage-substrates
 [{:kind :risingwave
   :binding "DATABASE_URL"
   :note "primary projection - psycopg2 batch INSERT from bulk-ingest workers"}]

 :projection/rebuild-estimated-minutes 360
 :projection/rebuild-estimated-minutes-note
 "dominated by Overture global + Wikidata LEI full + Wikipedia dumps + GeoNames full"

 :projection/non-determinism
 [{:field "vertex_*.row_id"
   :reason "sequence-allocated on INSERT; replays produce same logical row, different physical ID"}
  {:field "vertex_*.created_at_db"
   :reason "RW server timestamp at INSERT time, not in source record"}]

 :projection/promotion-to-l1
 {:required
  ["tools/rebuild-spatial-projection.ts implemented and exercised in CI smoke"
   "Each dumper subscribes to com.atproto.sync.subscribeRepos for maps.etzhayyim.com PDS in addition to the upstream fetch"
   "Drift detector: periodic random-CID re-derive + alert on divergence"]
  :target-quarter "Q3 2026 (after MIGRATION-TODO Phase 3)"}}
